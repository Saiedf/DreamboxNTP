# Dreambox/Linux runtime files must keep Unix LF line endings.
*.sh text eol=lf
*.py text eol=lf
*.service text eol=lf
*.timer text eol=lf
*.conf text eol=lf
*.md text eol=lf
*.txt text eol=lf
control/control text eol=lf
control/postinst text eol=lf
control/prerm text eol=lf
control/postrm text eol=lf
usr/bin/dreambox-ntp-sync text eol=lf

# Windows helper scripts keep native Windows line endings.
*.bat text eol=crlf

# Never apply text conversion to packaged or graphical assets.
*.deb binary
*.png binary
